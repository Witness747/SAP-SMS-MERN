# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
# Replace with your actual MongoDB Atlas connection URI in your local .env file
# Format: mongodb+srv://<username>:<password>@<cluster-url>/sap_sms?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Configuration
# Use a strong, random 256-bit key for production
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Configuration (Allowed frontend origin)
CLIENT_URL=http://localhost:5173

# Planner calendar timezone fallback when X-Client-Timezone is absent
APP_TIMEZONE=Asia/Kolkata

# Web Push Notification Configuration (Optional)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sap-sms.local
