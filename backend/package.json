{
  "name": "sap-sms-backend",
  "version": "1.0.0",
  "description": "Backend API for SAP-SMS (Student Academic Planner and Student Management System) built with Node.js, Express, and Mongoose.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:p3-config": "node --test test/p3TestDatabaseConfig.test.js",
    "test:p3-preflight": "node scripts/check-p3-test-db.js",
    "test:p3-integration": "node --test test/p3Pagination.integration.test.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset"
  },
  "keywords": [
    "mern",
    "sap-sms",
    "student-academic-planner",
    "express",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "Witness747",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
